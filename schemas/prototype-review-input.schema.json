{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.jlceda.invalid/schemas/prototype-review-input.schema.json",
  "title": "JLCEDA Prototype review normalized input",
  "type": "object",
  "required": ["schema", "designName", "components", "nets", "checks"],
  "$defs": {
    "confidence": {"enum": ["low", "medium", "high"]},
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "powerPath": {
      "type": "object",
      "required": ["regulatorRef", "inputNet", "outputNet", "sourceMinV"],
      "properties": {
        "regulatorRef": {"type": "string", "minLength": 1},
        "inputNet": {"type": "string", "minLength": 1},
        "outputNet": {"type": "string", "minLength": 1},
        "seriesRefs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "sourceMinV": {"type": "number", "minimum": 0},
        "sourceMaxV": {"type": "number", "minimum": 0},
        "outputV": {"type": "number", "minimum": 0},
        "confidence": {"$ref": "#/$defs/confidence"},
        "assumptions": {"$ref": "#/$defs/assumptions"}
      },
      "additionalProperties": true
    },
    "protectedCircuit": {
      "type": "object",
      "required": ["fuseRef", "continuousCurrentA", "surgeCurrentA"],
      "properties": {
        "fuseRef": {"type": "string", "minLength": 1},
        "continuousCurrentA": {"type": "number", "minimum": 0},
        "surgeCurrentA": {"type": "number", "minimum": 0},
        "holdDerating": {"type": "number", "exclusiveMinimum": 0},
        "confidence": {"$ref": "#/$defs/confidence"},
        "assumptions": {"$ref": "#/$defs/assumptions"}
      },
      "additionalProperties": true
    },
    "regulatorUse": {
      "type": "object",
      "required": ["regulatorRef", "inputMaxV", "loadMaxA"],
      "properties": {
        "regulatorRef": {"type": "string", "minLength": 1},
        "inputMaxV": {"type": "number", "minimum": 0},
        "loadMaxA": {"type": "number", "minimum": 0},
        "outputV": {"type": "number", "minimum": 0},
        "thermalResistanceCPerW": {"type": "number", "exclusiveMinimum": 0},
        "recommendedMaxDissipationW": {"type": "number", "exclusiveMinimum": 0},
        "cautionRiseC": {"type": "number", "minimum": 0},
        "blockerRiseC": {"type": "number", "minimum": 0},
        "confidence": {"$ref": "#/$defs/confidence"},
        "assumptions": {"$ref": "#/$defs/assumptions"}
      },
      "additionalProperties": true
    },
    "hbridgeUse": {
      "type": "object",
      "required": ["driverRef", "perChannelRunA", "channelsUsed"],
      "properties": {
        "driverRef": {"type": "string", "minLength": 1},
        "perChannelRunA": {"type": "number", "minimum": 0},
        "perChannelPeakA": {"type": "number", "minimum": 0},
        "channelsUsed": {"type": "integer", "minimum": 1},
        "maxEstimatedRiseC": {"type": "number", "exclusiveMinimum": 0},
        "confidence": {"$ref": "#/$defs/confidence"},
        "assumptions": {"$ref": "#/$defs/assumptions"}
      },
      "additionalProperties": true
    },
    "localCapRequirement": {
      "type": "object",
      "required": ["targetRef", "supplyNet"],
      "properties": {
        "targetRef": {"type": "string", "minLength": 1},
        "supplyNet": {"type": "string", "minLength": 1},
        "returnNet": {"type": "string", "minLength": 1},
        "minCapacitanceUf": {"type": "number", "minimum": 0},
        "maxCapacitanceUf": {"type": "number", "minimum": 0},
        "maxDistanceMm": {"type": "number", "minimum": 0},
        "severity": {"enum": ["blocker", "advisory"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "assumptions": {"$ref": "#/$defs/assumptions"}
      },
      "additionalProperties": true
    },
    "bulkCapRequirement": {
      "type": "object",
      "required": ["targetRef", "supplyNet", "minCapacitanceUf"],
      "properties": {
        "targetRef": {"type": "string", "minLength": 1},
        "supplyNet": {"type": "string", "minLength": 1},
        "returnNet": {"type": "string", "minLength": 1},
        "minCapacitanceUf": {"type": "number", "minimum": 0},
        "maxDistanceMm": {"type": "number", "minimum": 0},
        "severity": {"enum": ["blocker", "advisory"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "assumptions": {"$ref": "#/$defs/assumptions"}
      },
      "additionalProperties": true
    },
    "voltageDivider": {
      "type": "object",
      "required": ["id", "inputMaxV", "topOhm", "bottomOhm", "receiverAbsMaxV"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "inputMaxV": {"type": "number", "minimum": 0},
        "topOhm": {"type": "number", "exclusiveMinimum": 0},
        "bottomOhm": {"type": "number", "exclusiveMinimum": 0},
        "receiverAbsMaxV": {"type": "number", "exclusiveMinimum": 0},
        "requiredMarginV": {"type": "number", "minimum": 0},
        "locations": {"type": "array", "items": {"type": "string"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "assumptions": {"$ref": "#/$defs/assumptions"}
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "schema": {"const": "jlceda-prototype-review-input/1.0"},
    "designName": {"type": "string", "minLength": 1},
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "mpn": {"type": "string"},
          "profile": {"type": "string"},
          "package": {"type": "string"},
          "critical": {"type": "boolean"},
          "capacitanceUf": {"type": "number", "minimum": 0},
          "x": {"type": "number"},
          "y": {"type": "number"},
          "nets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": true
      }
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"type": "string"},
          "designCurrentA": {"type": "number", "minimum": 0},
          "minWidthMm": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": true
      }
    },
    "checks": {
      "type": "object",
      "properties": {
        "schematicErrors": {"type": "integer", "minimum": 0},
        "schematicWarnings": {"type": "integer", "minimum": 0},
        "schematicWarningDetailsAvailable": {"type": "boolean"},
        "schematicWarningDisposition": {"enum": ["unreviewed", "explained_and_accepted", "requires_correction"]},
        "pcbDrcFindings": {"type": "integer", "minimum": 0},
        "unroutedNets": {"type": "integer", "minimum": 0},
        "containment": {"type": "boolean"},
        "savedReloaded": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "schematicSheet": {
      "type": "object",
      "required": ["widthMm", "heightMm"],
      "description": "原理图页面/图框信息。约定:(originXmm, originYmm) 是图框左上角(毫米),x 向右为正、y 向下为负(EDA 原理图惯例);页面范围 x∈[originXmm, originXmm+widthMm],y∈[originYmm-heightMm, originYmm]。元件 x/y 先按 unitsPerMm 换算为毫米,再判定是否位于页面内。",
      "properties": {
        "widthMm": {"type": "number", "exclusiveMinimum": 0, "description": "页面物理宽度(毫米)"},
        "heightMm": {"type": "number", "exclusiveMinimum": 0, "description": "页面物理高度(毫米)"},
        "originXmm": {"type": "number", "default": 0, "description": "图框左上角 x(毫米),默认 0"},
        "originYmm": {"type": "number", "default": 0, "description": "图框左上角 y(毫米),默认 0;y 向下为负,页面下边界为 originYmm-heightMm"},
        "unitsPerMm": {"type": "number", "exclusiveMinimum": 0, "default": 1, "description": "元件坐标单位到毫米的换算(单位/毫米);例如坐标 10mil/unit → unitsPerMm=1/0.254≈3.937"},
        "containment": {"type": "boolean", "description": "外部已判定的页面包含结论(可选);提供时引擎短路,否则引擎由元件坐标自行几何判定"}
      },
      "additionalProperties": true
    },
    "fixtureMetadata": {
      "type": "object",
      "properties": {
        "fixtureType": {"type": "string"},
        "executionStatus": {"type": "string"},
        "liveEdaVerified": {"type": "boolean"},
        "persistenceEvidenceIncluded": {"type": "boolean"},
        "notForManufacturing": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "sourceEvidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "powerPaths": {"type": "array", "items": {"$ref": "#/$defs/powerPath"}},
    "protectedCircuits": {"type": "array", "items": {"$ref": "#/$defs/protectedCircuit"}},
    "hbridgeUses": {"type": "array", "items": {"$ref": "#/$defs/hbridgeUse"}},
    "regulatorUses": {"type": "array", "items": {"$ref": "#/$defs/regulatorUse"}},
    "decouplingRequirements": {"type": "array", "items": {"$ref": "#/$defs/localCapRequirement"}},
    "bulkCapRequirements": {"type": "array", "items": {"$ref": "#/$defs/bulkCapRequirement"}},
    "voltageDividers": {"type": "array", "items": {"$ref": "#/$defs/voltageDivider"}},
    "debugInterface": {
      "type": "object",
      "required": ["requiredSignals", "presentSignals"],
      "properties": {
        "requiredSignals": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "presentSignals": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "locations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "usability": {
      "type": "object",
      "properties": {
        "missingTestpointNets": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "missingSilkscreenLabels": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "antennaKeepout": {
          "type": "object",
          "required": ["verified"],
          "properties": {
            "verified": {"type": "boolean"},
            "confidence": {"$ref": "#/$defs/confidence"},
            "locations": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "assumptions": {"$ref": "#/$defs/assumptions"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "pcb": {
      "type": "object",
      "properties": {
        "traceCapacity": {
          "type": "object",
          "properties": {
            "copperOz": {"type": "number", "exclusiveMinimum": 0},
            "allowedRiseC": {"type": "number", "exclusiveMinimum": 0},
            "currentMargin": {"type": "number", "minimum": 1}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "groundReview": {
      "type": "object",
      "required": ["pours", "islands", "returnPathVerified", "powerLogicReturnSeparated"],
      "properties": {
        "pours": {"type": "integer", "minimum": 0},
        "islands": {"type": "integer", "minimum": 0},
        "returnPathVerified": {"type": "boolean"},
        "powerLogicReturnSeparated": {"type": "boolean"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "assumptions": {"$ref": "#/$defs/assumptions"}
      },
      "additionalProperties": true
    },
    "schematicTopology": {
      "type": "object",
      "required": ["floatingInputs", "sameNameConflicts", "pinPadVerified", "hiddenPowerPinsVerified"],
      "properties": {
        "floatingInputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "sameNameConflicts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "pinPadVerified": {"type": "boolean"},
        "hiddenPowerPinsVerified": {"type": "boolean"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "assumptions": {"$ref": "#/$defs/assumptions"}
      },
      "additionalProperties": true
    },
    "firmwarePins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pin"],
        "properties": {
          "pin": {"type": "string", "minLength": 1},
          "net": {"type": ["string", "null"], "minLength": 1},
          "port": {"type": "string"},
          "purpose": {"type": "string"},
          "direction": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
