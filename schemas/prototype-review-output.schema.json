{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.jlceda.invalid/schemas/prototype-review-output.schema.json",
  "title": "JLCEDA Prototype review result",
  "type": "object",
  "required": ["schema", "generatedAt", "designName", "rating", "counts", "findings"],
  "properties": {
    "schema": {"const": "jlceda-prototype-review/1.0"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "designName": {"type": "string", "minLength": 1},
    "rating": {
      "enum": [
        "not_suitable_for_prototype",
        "suitable_after_corrections",
        "suitable_for_low_risk_prototype"
      ]
    },
    "engineeringForecastRating": {
      "description": "Engineering-rule forecast with evidence-only findings excluded; never a current live prototype release rating.",
      "enum": [
        "not_suitable_for_prototype",
        "suitable_after_corrections",
        "suitable_for_low_risk_prototype"
      ]
    },
    "evidenceCompleteness": {
      "type": "object",
      "required": [
        "status",
        "requiredFields",
        "missingFields",
        "invalidFields",
        "contradictions",
        "scopeLimitations",
        "gates",
        "allRequiredEvidencePresentAndValid",
        "allPrototypeGatesPassed"
      ],
      "properties": {
        "status": {"enum": ["complete", "incomplete", "conflicting"]},
        "requiredFields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "missingFields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "invalidFields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "contradictions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "scopeLimitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "gates": {
          "type": "object",
          "required": ["schematicErrors", "schematicWarnings", "pcbDrcFindings", "unroutedNets", "containment", "savedReloaded"],
          "properties": {
            "schematicErrors": {"enum": ["pass", "fail", "missing", "invalid"]},
            "schematicWarnings": {"enum": ["pass", "missing", "invalid", "explained", "unexplained"]},
            "pcbDrcFindings": {"enum": ["pass", "fail", "missing", "invalid"]},
            "unroutedNets": {"enum": ["pass", "fail", "missing", "invalid"]},
            "containment": {"enum": ["pass", "fail", "missing", "invalid"]},
            "savedReloaded": {"enum": ["pass", "fail", "missing", "invalid"]}
          },
          "additionalProperties": false
        },
        "allRequiredEvidencePresentAndValid": {"type": "boolean"},
        "allPrototypeGatesPassed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["blocker", "advisory", "pass"],
      "properties": {
        "blocker": {"type": "integer", "minimum": 0},
        "advisory": {"type": "integer", "minimum": 0},
        "pass": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "confidence", "title", "locations", "evidence", "calculation", "ruleFamily"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["blocker", "advisory", "pass"]},
          "confidence": {"enum": ["low", "medium", "high"]},
          "title": {"type": "string"},
          "riskZh": {"type": "string"},
          "locations": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "object"}},
          "calculation": {"type": "string"},
          "recommendationZh": {"type": "string"},
          "revalidation": {"type": "string"},
          "unresolvedAssumptions": {"type": "array", "items": {"type": "string"}},
          "ruleFamily": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "sourceEvidence": {"type": "array", "items": {"type": "string"}},
    "ratingPolicy": {"type": "object"},
    "ratingAlgorithm": {"type": "object"}
  },
  "additionalProperties": true
}
