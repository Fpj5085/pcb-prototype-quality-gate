{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.jlceda.invalid/schemas/readonly-adapter-envelope.schema.json",
  "title": "JLCEDA read-only adapter evidence envelope",
  "type": "object",
  "required": ["schema", "status", "adapter", "capture", "normalizedDesign", "errors"],
  "properties": {
    "schema": {"const": "pcb-prototype-quality-gate-readonly-adapter/1.0"},
    "status": {"enum": ["complete", "failed", "unknown"]},
    "adapter": {
      "type": "object",
      "required": ["name", "version", "readOnly", "edaWrites"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "readOnly": {"const": true},
        "edaWrites": {"const": 0}
      },
      "additionalProperties": false
    },
    "capture": {
      "type": ["object", "null"],
      "required": ["capturedAt", "target", "state", "persistence"],
      "properties": {
        "capturedAt": {"type": "string", "format": "date-time"},
        "target": {
          "type": "object",
          "required": ["projectKeySha256", "schematicKeySha256", "pcbKeySha256"],
          "properties": {
            "projectKeySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "schematicKeySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "pcbKeySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "additionalProperties": false
        },
        "state": {
          "type": "object",
          "required": ["schematicStateSha256", "pcbStateSha256", "normalizedDesignSha256"],
          "properties": {
            "schematicStateSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "pcbStateSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "normalizedDesignSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          },
          "additionalProperties": false
        },
        "persistence": {
          "type": "object",
          "required": ["savedReloaded", "independentReadback", "targetStable"],
          "properties": {
            "savedReloaded": {"const": true},
            "independentReadback": {"const": true},
            "targetStable": {"const": true}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "normalizedDesign": {"type": ["object", "null"]},
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "message"],
        "properties": {
          "class": {
            "enum": [
              "adapter_unavailable",
              "no_window",
              "target_ambiguous",
              "target_drift",
              "timeout_unknown",
              "upstream_5xx",
              "malformed_response",
              "incomplete_evidence",
              "digest_mismatch",
              "unsupported_document",
              "internal_error"
            ]
          },
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}},
      "then": {
        "properties": {
          "capture": {"type": "object"},
          "normalizedDesign": {"type": "object"},
          "errors": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["failed", "unknown"]}}},
      "then": {
        "properties": {
          "capture": {"type": "null"},
          "normalizedDesign": {"type": "null"},
          "errors": {"minItems": 1}
        }
      }
    }
  ],
  "additionalProperties": false
}
