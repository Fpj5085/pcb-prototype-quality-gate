{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-jlceda-hardware-agent/schemas/m2-evidence-sha-manifest.schema.json",
  "title": "M2 sanitized evidence SHA manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "algorithm", "files"],
  "properties": {
    "schema": {
      "const": "jlceda-m2-evidence-sha-manifest/1.0"
    },
    "algorithm": {
      "const": "sha256"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
