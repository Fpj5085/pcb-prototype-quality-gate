{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.jlceda.invalid/schemas/requirements-input-1.0.0.json",
  "title": "JLCEDA Requirements Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "jlceda-requirements-input/1.0" },
    "description": { "type": ["string", "null"], "minLength": 1 },
    "powerInput": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "domainName": { "type": ["string", "null"], "minLength": 1 },
        "inputType": { "type": ["string", "null"], "minLength": 1 },
        "nominalVoltageV": { "type": ["number", "null"], "minimum": 0 },
        "minVoltageV": { "type": ["number", "null"], "minimum": 0 },
        "maxVoltageV": { "type": ["number", "null"], "minimum": 0 },
        "maxCurrentA": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "voltageDomains": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": ["string", "null"], "minLength": 1 },
              "nominalVoltageV": { "type": ["number", "null"], "minimum": 0 },
              "minVoltageV": { "type": ["number", "null"], "minimum": 0 },
              "maxVoltageV": { "type": ["number", "null"], "minimum": 0 },
              "maxCurrentA": { "type": ["number", "null"], "exclusiveMinimum": 0 }
            }
          }
        }
      }
    },
    "functionModules": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": ["string", "null"], "minLength": 1 },
          "name": { "type": ["string", "null"], "minLength": 1 },
          "role": { "type": ["string", "null"], "minLength": 1 },
          "designator": { "type": ["string", "null"], "minLength": 1 },
          "voltageDomain": { "type": ["string", "null"], "minLength": 1 },
          "requiredSignals": { "type": ["integer", "null"], "minimum": 0 },
          "maxCurrentA": { "type": ["number", "null"], "minimum": 0 },
          "ratedCurrentA": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "preferredPart": { "type": ["string", "null"], "minLength": 1 },
          "manufacturerId": { "type": ["string", "null"], "minLength": 1 },
          "supplierId": { "type": ["string", "null"], "minLength": 1 },
          "footprintUuid": { "type": ["string", "null"], "minLength": 1 },
          "notes": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "interfaceRequirements": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": ["string", "null"], "minLength": 1 },
          "direction": { "type": ["string", "null"], "minLength": 1 },
          "voltageDomain": { "type": ["string", "null"], "minLength": 1 },
          "signals": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": ["string", "null"], "minLength": 1 },
                "mcuPin": { "type": ["string", "null"], "minLength": 1 },
                "direction": { "type": ["string", "null"], "minLength": 1 },
                "activeLevel": { "type": ["string", "null"], "minLength": 1 },
                "voltageDomain": { "type": ["string", "null"], "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "mechanical": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "boardSizeMm": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "widthMm": { "type": ["number", "null"], "minimum": 0 },
            "heightMm": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "connectorPositions": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": ["string", "null"], "minLength": 1 },
              "positionMm": { "type": ["string", "null"], "minLength": 1 }
            }
          }
        },
        "notes": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "acceptanceCriteria": {
      "type": ["array", "null"],
      "items": { "type": "string", "minLength": 1 }
    },
    "providedMaterials": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "forModule": { "type": ["string", "null"], "minLength": 1 },
          "partNumber": { "type": ["string", "null"], "minLength": 1 },
          "manufacturerId": { "type": ["string", "null"], "minLength": 1 },
          "supplierId": { "type": ["string", "null"], "minLength": 1 },
          "footprintUuid": { "type": ["string", "null"], "minLength": 1 },
          "description": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    }
  }
}
